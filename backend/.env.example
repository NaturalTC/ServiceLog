# Copy to backend/.env for local development. Never commit .env.
# Generate a secret with: openssl rand -base64 48
JWT_SECRET=
# Creates the owner's account on first startup; remove OWNER_PASSWORD afterwards
OWNER_EMAIL=
OWNER_PASSWORD=

# Email. Leave unset in development to use Mailpit (docker compose, inbox at :8025)
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=ServiceLog <no-reply@your-domain>
# FRONTEND_URL=http://localhost:5173

# AI drafts of service records (optional; off when unset). Model defaults to gpt-5.4-mini.
# OPENAI_API_KEY=
# AI_MODEL=
