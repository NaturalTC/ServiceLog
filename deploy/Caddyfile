# ServiceLog's web server. {$DOMAIN} comes from the environment, e.g. app.example.com.
# Caddy gets a free HTTPS certificate for it automatically and renews it.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The API (and its health check) go to Spring Boot
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Everything else is the React app; unknown paths fall back to index.html
	handle {
		root * /srv
		# The service worker and index.html must never be cached, or updates get stuck
		@nocache path /sw.js /index.html /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		# Built assets have content hashes in their names, so they can be cached for a year
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
