# Copy to /opt/servicelog/.env on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -base64 48

# The address people type, with DNS pointing at this server (HTTPS is automatic)
DOMAIN=app.example.com

DB_PASSWORD=
JWT_SECRET=

# Creates the owner's account on first start; remove OWNER_PASSWORD afterwards
OWNER_EMAIL=
OWNER_PASSWORD=

# Outgoing email (e.g. Resend, Amazon SES or Postmark SMTP settings)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ServiceLog <no-reply@example.com>

# How reminder emails are signed
BUSINESS_NAME=
BUSINESS_PHONE=

# AI drafts of service records (optional; leave blank to turn the feature off)
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
